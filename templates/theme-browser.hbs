<div class="dicer-theme-browser-body">
  <div class="dicer-toolbar">
    <nav class="dicer-segmented" aria-label="{{localize "DICER.Themes.Filter"}}">
      {{#each filters}}
        <button type="button" class="{{#if active}}active{{/if}}" data-action="filter" data-filter="{{id}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
          {{#if iconClass}}<i class="{{iconClass}}" aria-hidden="true"></i> {{/if}}{{#if iconSrc}}<img class="dicer-tab-icon" src="{{iconSrc}}" alt="" aria-hidden="true"> {{/if}}{{label}} <span class="dicer-count">{{count}}</span>
        </button>
      {{/each}}
    </nav>
    <label class="dicer-theme-search">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" name="dicerThemeSearch" value="{{query}}" placeholder="{{localize "DICER.Themes.Search"}}" aria-label="{{localize "DICER.Themes.SearchHint"}}" autocomplete="off" spellcheck="false">
    </label>
    <div class="dicer-toolbar-actions">
      <button type="button" class="bright" data-action="create"><i class="fa-solid fa-palette"></i> {{localize "DICER.Themes.Create"}}</button>
      <button type="button" data-action="importThemes"><i class="fa-solid fa-file-import"></i> {{localize "DICER.Themes.Import"}}</button>
      <button type="button" data-action="exportMine"><i class="fa-solid fa-file-export"></i> {{localize "DICER.Themes.ExportMine"}}</button>
      <button type="button" data-action="openPet" data-tooltip="DICER.PetWindow.ButtonHint"><i class="fa-solid fa-dragon"></i> {{localize "DICER.PetWindow.Button"}}</button>
      {{#if isGM}}<button type="button" data-action="openInstalledDice" data-tooltip="DICER.Themes.InstalledDiceHint"><i class="fa-solid fa-box-open"></i> {{localize "DICER.Themes.InstalledDice"}}</button>{{/if}}
      <button type="button" data-action="openStats" data-tooltip="DICER.Stats.ButtonHint"><i class="fa-solid fa-chart-column"></i> {{localize "DICER.Stats.Button"}}</button>
      <button type="button" data-action="openTray" data-tooltip="DICER.Themes.TrayHint"><i class="fa-solid fa-chess-board"></i> {{localize "DICER.Themes.Tray"}}</button>
      <button type="button" class="dicer-icon" data-action="openSettings" data-tooltip="DICER.Themes.SettingsHint" aria-label="{{localize "DICER.Themes.SettingsHint"}}"><i class="fa-solid fa-gear"></i></button>
    </div>
    <input type="file" class="dicer-theme-file" accept=".json,application/json" hidden>
  </div>

  <div class="dicer-theme-main">
    <div class="dicer-theme-grid" role="listbox" aria-label="{{localize "DICER.Themes.Title"}}">
      {{#unless hasCards}}<p class="dicer-empty">{{#if noMatch}}{{localize "DICER.Themes.SearchEmpty"}}{{else}}{{localize "DICER.Themes.Empty"}}{{/if}}</p>{{/unless}}
      {{#each cards}}
        {{#if section}}<h4 class="dicer-theme-section">{{section}}</h4>{{/if}}
        <div class="dicer-theme-card {{#if selected}}is-selected{{/if}}" data-theme="{{id}}" data-action="select" role="option" tabindex="0" aria-selected="{{#if selected}}true{{else}}false{{/if}}">
          <div class="dicer-stage" style="--dicer-swatch: {{swatch}}">
            <i class="dicer-fallback fa-solid fa-dice-d20" aria-hidden="true"></i>
            <img class="dicer-thumb" data-theme="{{id}}" alt="" hidden>
            {{#if isDefault}}<span class="dicer-mark dicer-mark-default" data-tooltip="DICER.Themes.YourDefault" aria-label="{{localize "DICER.Themes.YourDefault"}}"><i class="fa-solid fa-star"></i></span>{{/if}}
            {{#if slotCount}}<span class="dicer-mark dicer-mark-slots" data-tooltip="{{slotTooltip}}" aria-label="{{slotTooltip}}"><i class="fa-solid fa-link"></i> {{slotCount}}</span>{{/if}}
          </div>
          <div class="dicer-card-name" title="{{name}}">{{name}}</div>
          {{#if showBadge}}<div class="dicer-card-meta"><span class="dicer-badge dicer-badge-{{source}}" title="{{sourceLabel}}">{{sourceLabel}}</span></div>{{/if}}
        </div>
      {{/each}}
      {{#if unreadable.length}}
        <div class="dicer-unreadable">
          <p>{{localize "DICER.Themes.Unreadable"}}</p>
          <ul>{{#each unreadable}}<li>{{label}} ({{sourceLabel}})</li>{{/each}}</ul>
        </div>
      {{/if}}
    </div>

    {{#if detail}}
      <aside class="dicer-theme-detail" data-theme="{{detail.id}}">
        <div class="dicer-stage dicer-stage-large" style="--dicer-swatch: {{detail.swatch}}">
          <i class="dicer-fallback fa-solid fa-dice-d20" aria-hidden="true"></i>
          <img class="dicer-thumb" data-theme="{{detail.id}}" alt="{{detail.name}}" hidden>
          <canvas class="dicer-live" role="img" aria-label="{{detail.name}}" hidden></canvas>
        </div>
        <header class="dicer-detail-head">
          <h3>{{detail.name}}</h3>
          <span class="dicer-badge dicer-badge-{{detail.source}}">{{detail.sourceLabel}}</span>
        </header>
        {{#if detail.credit}}<p class="dicer-muted dicer-credit"><i class="fa-solid fa-palette"></i> {{detail.credit}}</p>{{/if}}

        {{#if detail.isModule}}
        <p class="dicer-muted">{{detail.kindLabel}}</p>
        {{#if detail.setFx}}
          <label class="dicer-check dicer-set-fx" data-tooltip="DICER.Themes.Module.SetFxHint">
            <input type="checkbox" data-action="setFx" data-theme="{{detail.id}}"{{#if detail.setFxOn}} checked{{/if}}>
            {{localize "DICER.Themes.Module.SetFx"}}
          </label>
        {{/if}}
        {{#if detail.moonDice}}
          <label class="dicer-check dicer-moon-dice" data-tooltip="DICER.Themes.Module.MoonDiceHint">
            <input type="checkbox" data-action="moonDice" data-theme="{{detail.id}}"{{#if detail.moonDiceOn}} checked{{/if}}{{#if locked}} disabled{{/if}}>
            {{localize "DICER.Themes.Module.MoonDice"}}
          </label>
        {{/if}}
        {{#if locked}}
          <p class="dicer-muted dicer-locked"><i class="fa-solid fa-lock"></i> {{lockedNotice}}</p>
        {{else}}
          {{#if detail.isDefault}}
            <p class="dicer-is-default"><i class="fa-solid fa-star"></i> {{localize "DICER.Themes.YourDefault"}}</p>
            {{#if detail.canStop}}<button type="button" data-action="stopModule" data-theme="{{detail.id}}"><i class="fa-solid fa-eraser"></i> {{localize "DICER.Themes.Module.Stop"}}</button>{{/if}}
          {{else}}
            <button type="button" class="bright dicer-primary" data-action="useModule" data-theme="{{detail.id}}"><i class="fa-solid fa-star"></i> {{localize "DICER.Themes.UseAsDefault"}}</button>
          {{/if}}
          <div class="dicer-detail-section">
            <label class="dicer-field">
              <span>{{localize "DICER.Themes.UseFor"}}</span>
              <select class="dicer-target">
                {{#each moduleTargetGroups}}
                  <optgroup label="{{label}}">
                    {{#each options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
                  </optgroup>
                {{/each}}
              </select>
            </label>
            <div class="dicer-button-row">
              <button type="button" data-action="apply" data-theme="{{detail.id}}"><i class="fa-solid fa-check"></i> {{localize "DICER.Themes.Apply"}}</button>
              <button type="button" data-action="clear" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.ClearHint"><i class="fa-solid fa-eraser"></i> {{localize "DICER.Themes.Clear"}}</button>
            </div>
          </div>
          {{#if detail.assigned.length}}
          <div class="dicer-detail-section">
            <h4>{{localize "DICER.Themes.AssignedTo"}}</h4>
            <ul class="dicer-chips">
              {{#each detail.assigned}}
                <li class="dicer-chip {{#if isDefault}}is-default{{/if}}">
                  <span>{{label}}</span>
                  {{#unless isDefault}}<button type="button" class="dicer-chip-x" data-action="clear" data-target="{{target}}" data-tooltip="DICER.Themes.ClearSlot" aria-label="{{localize "DICER.Themes.ClearSlot"}}"><i class="fa-solid fa-xmark"></i></button>{{/unless}}
                </li>
              {{/each}}
            </ul>
          </div>
          {{/if}}
        {{/if}}
        <div class="dicer-detail-section dicer-detail-actions">
          <button type="button" data-action="importModule" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.Module.ImportHint"><i class="fa-solid fa-file-import"></i> {{localize "DICER.Themes.Module.Import"}}</button>
          <button type="button" data-action="throwTheme" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.ThrowHint"><i class="fa-solid fa-dice"></i> {{localize "DICER.Themes.Throw"}}</button>
        </div>
        {{#if detail.dropNote}}<p class="dicer-muted">{{detail.dropNote}}</p>{{/if}}
        {{else}}
        {{#if locked}}
          <p class="dicer-muted dicer-locked"><i class="fa-solid fa-lock"></i> {{lockedNotice}}</p>
        {{else}}
          {{#if detail.isDefault}}
            <p class="dicer-is-default"><i class="fa-solid fa-star"></i> {{localize "DICER.Themes.YourDefault"}}</p>
          {{else}}
            <button type="button" class="bright dicer-primary" data-action="useDefault" data-theme="{{detail.id}}"><i class="fa-solid fa-star"></i> {{localize "DICER.Themes.UseAsDefault"}}</button>
          {{/if}}
        {{/if}}
        {{#if detail.canWorldDefault}}
          {{#if detail.isWorldDefault}}
            <p class="dicer-is-default"><i class="fa-solid fa-globe"></i> {{localize "DICER.Themes.WorldDefault"}}
              <button type="button" data-action="worldDefault" data-theme="" data-tooltip="DICER.Themes.ClearWorldDefaultHint"><i class="fa-solid fa-eraser"></i> {{localize "DICER.Themes.ClearWorldDefault"}}</button></p>
          {{else}}
            <button type="button" data-action="worldDefault" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.UseAsWorldDefaultHint"><i class="fa-solid fa-globe"></i> {{localize "DICER.Themes.UseAsWorldDefault"}}</button>
          {{/if}}
        {{/if}}

        {{#unless locked}}
        <div class="dicer-detail-section">
          <label class="dicer-field">
            <span>{{localize "DICER.Themes.UseFor"}}</span>
            <select class="dicer-target">
              {{#each targetGroups}}
                <optgroup label="{{label}}">
                  {{#each options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
                </optgroup>
              {{/each}}
            </select>
          </label>
          <div class="dicer-button-row">
            <button type="button" data-action="apply" data-theme="{{detail.id}}"><i class="fa-solid fa-check"></i> {{localize "DICER.Themes.Apply"}}</button>
            <button type="button" data-action="clear" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.ClearHint"><i class="fa-solid fa-eraser"></i> {{localize "DICER.Themes.Clear"}}</button>
          </div>
        </div>
        {{/unless}}

        <div class="dicer-detail-section">
          <h4>{{localize "DICER.Themes.AssignedTo"}}</h4>
          {{#if detail.assigned.length}}
            <ul class="dicer-chips">
              {{#each detail.assigned}}
                <li class="dicer-chip {{#if isDefault}}is-default{{/if}}">
                  <span>{{label}}</span>
                  {{#unless isDefault}}{{#unless @root.locked}}<button type="button" class="dicer-chip-x" data-action="clear" data-target="{{target}}" data-tooltip="DICER.Themes.ClearSlot" aria-label="{{localize "DICER.Themes.ClearSlot"}}"><i class="fa-solid fa-xmark"></i></button>{{/unless}}{{/unless}}
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="dicer-muted">{{localize "DICER.Themes.NotAssigned"}}</p>
          {{/if}}
        </div>

        <div class="dicer-detail-section dicer-detail-actions">
          <button type="button" data-action="duplicate" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.Duplicate"><i class="fa-solid fa-clone"></i> {{localize "DICER.Themes.DuplicateShort"}}</button>
          <button type="button" data-action="throwTheme" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.ThrowHint"><i class="fa-solid fa-dice"></i> {{localize "DICER.Themes.Throw"}}</button>
          {{#if detail.canEdit}}<button type="button" data-action="edit" data-theme="{{detail.id}}"><i class="fa-solid fa-pen"></i> {{localize "DICER.Themes.Edit"}}</button>{{/if}}
          <button type="button" data-action="exportOne" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.Export"><i class="fa-solid fa-download"></i> {{localize "DICER.Themes.ExportShort"}}</button>
          {{#if detail.canPush}}<button type="button" data-action="push" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.PushHint"><i class="fa-solid fa-users"></i> {{localize "DICER.Themes.PushShort"}}</button>{{/if}}
          {{#if detail.canPublish}}<button type="button" data-action="publish" data-theme="{{detail.id}}" data-tooltip="DICER.Themes.Publish"><i class="fa-solid fa-globe"></i> {{localize "DICER.Themes.PublishShort"}}</button>{{/if}}
          {{#if detail.canDelete}}<button type="button" class="dicer-danger" data-action="remove" data-theme="{{detail.id}}"><i class="fa-solid fa-trash"></i> {{localize "DICER.Themes.Delete"}}</button>{{/if}}
        </div>
        {{/if}}
      </aside>
    {{/if}}
  </div>
</div>
